# ============================================================================
# CONVEX DEPLOYMENT & REALTIME CONFIGURATION
# ============================================================================
# Generated when running `npx convex dev` or linking your Convex deployment
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ============================================================================
# AI AGENT & MODEL CONFIGURATION
# ============================================================================
# Local Ollama instance (default: http://localhost:11434 with qwen3.6:27b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b

# Optional Cloud API keys (Fallback if Ollama is offline)
OPENAI_API_KEY=
GROQ_API_KEY=

# ============================================================================
# RESEND EMAIL SERVICE (Visitor messages & Resume dispatch)
# ============================================================================
# Get your API key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ritesh AI <onboarding@resend.dev>"
